configfile: "config.yaml"

import pandas as pd

sample_table = pd.read_table("SraRunTable.csv", sep=",")
samples = list(sample_table['Sample Name'].unique())

pc_table = pd.read_table("peakcall_map.txt", sep="\t")
PC = list(pc_table['name'])

MACS2_BROAD = config.get('macs2_broad', False)
FRAGMENT_LENGTH = int(config.get('fragment_length', 200))
MACS2_PVALUE = config.get('macs2_pvalue', 0.01)
macs2_peak_suffix = "broadPeak" if MACS2_BROAD else "narrowPeak"

# optional: reuse an existing bowtie2 index / known genome size
USER_INDEX = config.get('bowtie_index')
INDEX_PREFIX = USER_INDEX if USER_INDEX else "bowtie_index/genome"
INDEX_FLAG = (USER_INDEX + ".1.bt2") if USER_INDEX else "bowtie_index/genome.done"
USER_GSIZE = config.get('genome_size')
MAX_SPOTS = int(config.get('max_spots', 0))

def runs_of(sn):
    return list(sample_table[sample_table['Sample Name'] == sn].Run)

# compute nodes have no internet
localrules: all, prefetch, getGenomeFasta


rule all:
    input:
        expand("peak_calls/{PC}_peaks." + macs2_peak_suffix, PC=PC),
        expand("{SN}_out/{SN}_ranges.rds", SN=samples),
        expand("{SN}_out/{SN}_coverage.bw", SN=samples),
        "qc/multiqc_report.html"


rule macs2:
    input:
        IP=lambda wc: expand("{IP}_out/{IP}.bam",
            IP=pc_table[pc_table['name'] == wc.PC].enriched.tolist()),
        control=lambda wc: expand("{ctrl}_out/{ctrl}.bam",
            ctrl=pc_table[pc_table['name'] == wc.PC].control.tolist()),
        gsize=lambda wc: [] if USER_GSIZE else "genome_size.txt"
    output:
        "peak_calls/{PC}_peaks." + macs2_peak_suffix
    params:
        gsize=lambda wc, input: str(USER_GSIZE) if USER_GSIZE else open(input.gsize).read().strip(),
        extsize=FRAGMENT_LENGTH if FRAGMENT_LENGTH > 0 else 200,
        pvalue=MACS2_PVALUE,
        broad_flag="--broad" if MACS2_BROAD else ""
    log:
        "peak_calls/{PC}_macs2.log"
    resources:
        mem_mb=16000
    shell:
        """
        macs2 callpeak \
            -t {input.IP} \
            -c {input.control} \
            -f BAM \
            -g {params.gsize} \
            --nomodel --extsize {params.extsize} \
            -p {params.pvalue} \
            --outdir peak_calls \
            -n {wildcards.PC} \
            {params.broad_flag} \
            2> {log}
        """


rule bam2rangeAndcoverage:
    input:
        "{SN}_out/{SN}.bam"
    output:
        rds="{SN}_out/{SN}_ranges.rds",
        bw="{SN}_out/{SN}_coverage.bw"
    params:
        fragment_length=FRAGMENT_LENGTH
    resources:
        mem_mb=16000
    shell:
        "Rscript --vanilla scripts/bam2coverage.R {input} {params.fragment_length} {output.rds} {output.bw}"


# unique reads only: reads with a bowtie2 XS:i tag (second-best alignment) are
# dropped; duplicates are removed. Runs of one sample are merged. The final
# BAM is coordinate-sorted and indexed.
rule bowtie:
    input:
        reads=lambda wc: expand("raw/{run}.fastq.gz", run=runs_of(wc.SN)),
        index=INDEX_FLAG
    params:
        reads=lambda wc: ",".join(expand("raw/{run}.fastq.gz", run=runs_of(wc.SN))),
        index=INDEX_PREFIX
    output:
        bam="{SN}_out/{SN}.bam",
        bai="{SN}_out/{SN}.bam.bai"
    log:
        align="{SN}_out/alignstats.txt",
        markdup="{SN}_out/markdup_stats.txt"
    threads: 16
    resources:
        mem_mb=32000
    shell:
        """
        bowtie2 -p {threads} --no-unal -x {params.index} -U {params.reads} 2> {log.align} | \
            awk -F'\\t' '/^@/ {{print; next}} {{for (i = 12; i <= NF; i++) if ($i ~ /^XS:i:/) next; print}}' | \
            samtools sort -u -m 2G -@ 4 -T {wildcards.SN}_out/tmp_cs - | \
            samtools markdup -r -@ 4 -f {log.markdup} - {output.bam}
        samtools index -@ {threads} {output.bam}
        """


rule bam_qc:
    input:
        "{SN}_out/{SN}.bam"
    output:
        flagstat="{SN}_out/{SN}.flagstat",
        stats="{SN}_out/{SN}.stats"
    threads: 2
    resources:
        mem_mb=2000
    shell:
        """
        samtools flagstat -@ {threads} {input} > {output.flagstat}
        samtools stats -@ {threads} {input} > {output.stats}
        """


rule multiqc:
    input:
        expand("{SN}_out/alignstats.txt", SN=samples),
        expand("{SN}_out/{SN}.flagstat", SN=samples),
        expand("{SN}_out/{SN}.stats", SN=samples)
    output:
        "qc/multiqc_report.html"
    resources:
        mem_mb=4000
    shell:
        "multiqc -f -q -n multiqc_report.html -o qc {input}"


rule fastq_dump:
    input:
        "sra/{SRR}/{SRR}.sra"
    output:
        temp("raw/{SRR}.fastq.gz")
    params:
        spots=f"-X {MAX_SPOTS}" if MAX_SPOTS > 0 else ""
    resources:
        mem_mb=2000
    shell:
        """
        fastq-dump --gzip {params.spots} {input} --outdir raw
        rm -rf sra/{wildcards.SRR}
        """


rule prefetch:
    output:
        "sra/{SRR}/{SRR}.sra"
    shell:
        "prefetch --max-size 100G -O sra {wildcards.SRR}"


rule getGenomeFasta:
    params:
        genomeLocation=config['genomeFTP']
    output:
        temp("genome.fa")
    shell:
        """
        wget -q -O genome.fa.gz {params.genomeLocation}
        gunzip -f genome.fa.gz
        """


# effective genome size = number of A/C/G/T bases
rule get_genome_size:
    input:
        "genome.fa"
    output:
        "genome_size.txt"
    shell:
        "grep -v '>' {input} | tr -cd 'ACGTacgt' | wc -c > {output}"


rule index_bowtie:
    input:
        "genome.fa"
    output:
        "bowtie_index/genome.done"
    threads: 16
    resources:
        mem_mb=32000
    shell:
        """
        mkdir -p bowtie_index
        bowtie2-build --threads {threads} {input} bowtie_index/genome
        touch {output}
        """
