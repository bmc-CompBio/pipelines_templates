configfile: "config.yaml"

import pandas as pd

sample_table = pd.read_table(config["runtable"], sep=",")
samples = list(sample_table['Sample Name'].unique())
first_run = sample_table.iloc[0]['Run']

STRAND = str(config.get("strandedness", "auto")).lower()
assert STRAND in {"auto", "none", "unstranded", "forward", "reverse"}, \
    "strandedness must be auto, none, forward or reverse"
FRAG_MEAN = config.get("frag_mean", 200)
FRAG_SD = config.get("frag_sd", 20)
BOOTSTRAPS = int(config.get("bootstraps", 30))
MAX_SPOTS = int(config.get("max_spots", 0))

def runs_of(srs):
    return list(sample_table[sample_table['Sample Name'] == srs].Run)

# compute nodes have no internet; get_index_files downloads the annotation
localrules: all, prefetch, get_index_files, create_se, set_strandedness


rule all:
    input:
        "se.rds",
        "qc/multiqc_report.html"


rule create_se:
    input:
        expand("{SRS}_out/{SRS}.abundance.tsv", SRS=samples),
        "genome.gtf.gz",
        "entrez.tsv.gz"
    output:
        "se.rds"
    script:
        "scripts/toSe.R"


rule multiqc:
    input:
        expand("{SRS}_out/{SRS}.kallisto.log", SRS=samples)
    output:
        "qc/multiqc_report.html"
    resources:
        mem_mb=4000
    shell:
        "multiqc -f -q -n multiqc_report.html -o qc {input}"


# all runs of a sample are quantified together
rule kallisto:
    input:
        reads=lambda wc: expand("raw/{run}.fastq.gz", run=runs_of(wc.SRS)),
        index="kallisto_index/genome",
        strandedness="results/strandedness.txt"
    output:
        "{SRS}_out/{SRS}.abundance.h5",
        "{SRS}_out/{SRS}.abundance.tsv"
    params:
        frag_mean=FRAG_MEAN,
        frag_sd=FRAG_SD,
        bootstraps=BOOTSTRAPS
    log:
        "{SRS}_out/{SRS}.kallisto.log"
    threads: 16
    resources:
        mem_mb=8000
    shell:
        """
        case $(cat {input.strandedness}) in
            reverse) strand_flag="--rf-stranded" ;;
            forward) strand_flag="--fr-stranded" ;;
            *)       strand_flag="" ;;
        esac
        kallisto quant --index={input.index} --output-dir={wildcards.SRS}_out \
            --threads={threads} -b {params.bootstraps} \
            --single -l {params.frag_mean} -s {params.frag_sd} \
            $strand_flag {input.reads} 2> {log}
        mv {wildcards.SRS}_out/abundance.h5 {wildcards.SRS}_out/{wildcards.SRS}.abundance.h5
        mv {wildcards.SRS}_out/abundance.tsv {wildcards.SRS}_out/{wildcards.SRS}.abundance.tsv
        """


rule kallisto_index:
    input:
        "transcripts.fa.gz"
    output:
        temp("kallisto_index/genome")
    resources:
        mem_mb=8000
    shell:
        """
        mkdir -p kallisto_index
        kallisto index --index={output} {input}
        """


if STRAND == "auto":

    # strandedness from 100k reads of the first run: salmon with automatic
    # library type detection
    rule subset_reads:
        input:
            f"raw/{first_run}.fastq.gz"
        output:
            temp("subsets/salmon_subset.fastq.gz")
        shell:
            """
            mkdir -p subsets
            gzip -dc {input} | head -n 400000 | gzip > {output} || true
            """

    rule salmon_index:
        input:
            "transcripts.fa.gz"
        output:
            temp(directory("salmon_index"))
        threads: 16
        resources:
            mem_mb=32000
        shell:
            "salmon index -t {input} -i {output} -p {threads}"

    rule salmon_alignment:
        input:
            reads="subsets/salmon_subset.fastq.gz",
            index="salmon_index"
        output:
            "salmon_quant/aux_info/meta_info.json"
        params:
            frag_mean=FRAG_MEAN,
            frag_sd=FRAG_SD
        threads: 8
        resources:
            mem_mb=16000
        shell:
            """
            salmon quant --index={input.index} --libType A -r {input.reads} \
                --fldMean {params.frag_mean} --fldSD {params.frag_sd} \
                -p {threads} --output salmon_quant
            """

    rule determine_strandedness:
        input:
            json="salmon_quant/aux_info/meta_info.json"
        output:
            strandedness="results/strandedness.txt"
        script:
            "scripts/determine_strandedness.py"

else:

    rule set_strandedness:
        output:
            strandedness="results/strandedness.txt"
        params:
            value="unstranded" if STRAND in ("none", "unstranded") else STRAND
        shell:
            "mkdir -p results && echo {params.value} > {output.strandedness}"


rule fastq_dump:
    input:
        "sra/{SRR}/{SRR}.sra"
    output:
        temp("raw/{SRR}.fastq.gz")
    params:
        spots=f"-X {MAX_SPOTS}" if MAX_SPOTS > 0 else ""
    resources:
        mem_mb=2000
    shell:
        """
        mkdir -p raw
        fastq-dump --gzip {params.spots} {input} --outdir raw
        rm -rf sra/{wildcards.SRR}
        """


rule prefetch:
    output:
        "sra/{SRR}/{SRR}.sra"
    shell:
        "prefetch -O sra {wildcards.SRR}"


# GTF, cDNA FASTA and (optionally) ncRNA FASTA; "id|gene|..." headers are cut to the id
rule get_index_files:
    params:
        gtfLocation=config['gtfFTP'],
        entrezLocation=config.get('entrezFTP') or config['gtfFTP'].replace('/gtf/', '/tsv/').replace('.gtf.gz', '.entrez.tsv.gz'),
        transcriptLocation=config['transcriptsFTP'],
        ncrnaLocation=config.get('ncrnaFTP', '')
    output:
        "genome.gtf.gz",
        "entrez.tsv.gz",
        "transcripts.fa.gz"
    shell:
        """
        wget -q -O genome.gtf.gz {params.gtfLocation}
        wget -q -O entrez.tsv.gz {params.entrezLocation}
        ( wget -q -O - {params.transcriptLocation} | gunzip -c
          if [ -n "{params.ncrnaLocation}" ]; then wget -q -O - {params.ncrnaLocation} | gunzip -c; fi
        ) | awk -F '|' '{{print $1}}' | gzip > transcripts.fa.gz
        """
